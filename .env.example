# コピー: cp .env.example .env
WP_APP_POST_ID=
WP_APP_PAGE_URL=https://apps.tomippe.jp/gradatone/
ASC_APP_ID=
BUNDLE_ID=jp.tomippe.gradatone
WP_POLICY_POST_ID=
WP_POLICY_PAGE_URL=https://apps.tomippe.jp/gradatone/policy/

# Google Play（JSON パスは ~/Secrets/google-play.env）
GOOGLE_PLAY_PACKAGE_NAME=jp.tomippe.gradatone
# TWA assetlinks 生成先（サイトルート FTP 用）
# ASSETLINKS_OUT_DIR=public/.well-known
# Play App Signing の SHA-256（初回 AAB 後に設定可）
# GOOGLE_PLAY_APP_SIGNING_SHA256=
